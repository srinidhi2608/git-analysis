# =============================================================================
# Git Analysis — environment settings
# Copy to .env and fill in GITHUB_TOKEN:   cp .env.example .env
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────
# GitHub Personal Access Token with read access to the repositories in config.yaml
# (classic PAT: `repo` scope; fine-grained PAT: "Pull requests: Read" + "Contents: Read").
GITHUB_TOKEN=ghp_replace_me

# ── Database ─────────────────────────────────────────────────────────────────
# Password for the PostgreSQL container started by docker compose.
POSTGRES_PASSWORD=changeme
# Used only when you run the backend outside Docker. The default matches the
# docker compose `db` service, so `docker compose up -d db` is enough locally.
# (docker compose sets DATABASE_URL for the app container itself.)
DATABASE_URL=postgresql+psycopg2://git_user:changeme@localhost:5432/git_analysis

# ── Ports used by docker compose (optional) ──────────────────────────────────
# APP_PORT=8000
# POSTGRES_PORT=5432

# ── AI / LLM analysis (optional — a rule-based fallback always works) ─────────
# Tier 1 – online OpenAI-compatible API (gpt-* → OpenAI, gemini-* → Google)
ONLINE_AI_ENABLED=false
ONLINE_AI_API_KEY=
ONLINE_AI_MODEL=gemini-1.5-pro
# Tier 2 – local Ollama. Leave OLLAMA_BASE_URL unset to use the defaults:
#   running locally   → http://localhost:11434
#   in docker compose → http://host.docker.internal:11434 (Ollama on your machine)
# With `docker compose --profile ollama` set it to http://ollama:11434
# OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5-coder:14b

# ── Azure DevOps (optional — DevOps Integration page) ────────────────────────
# Personal access token with "Work Items: Read" and "Build: Read" scopes.
# Organization and projects are configured in config.yaml (azure_devops).
AZURE_DEVOPS_PAT=

# ── Production (see README "Production deployment") ──────────────────────────
# HTTPS turns on automatically when certs/tls/server.crt + server.key exist.
# TLS_ENABLED=auto              # auto | true | false
# REQUIRE_TLS=false             # true: refuse to start without a certificate
# TLS_KEY_PASSWORD=             # for an encrypted private key
# CORS_ALLOW_ORIGINS=*          # comma-separated origins; empty = no cross-origin access
# ENABLE_API_DOCS=true          # /docs, /redoc, /openapi.json
# LOG_LEVEL=info
# FORWARDED_ALLOW_IPS=127.0.0.1 # reverse proxy IPs trusted for X-Forwarded-* headers
# WEB_CONCURRENCY=1             # uvicorn workers (keep 1, see README)

# ---------------------------------------------------------------------------
# Metric thresholds (change these to tune dashboard scoring and trend signals)
# ---------------------------------------------------------------------------
LARGE_PR_THRESHOLD_LINES=600
FOLLOWUP_GOOD_THRESHOLD_HOURS=12
REQUESTED_CHANGES_RISKY_PCT=30
HIGH_COMMENTS_PER_PR_THRESHOLD=2
LEAD_TIME_HEALTHY_HOURS=48
FIRST_REVIEW_HEALTHY_HOURS=24
REVIEW_COVERAGE_GOOD_PCT=80
APPROVAL_RATE_GOOD_PCT=60
CHANGE_FAILURE_ACCEPTABLE_PCT=35
CONFIDENCE_MIN_PRS=5
CONFIDENCE_MIN_COMMENTS=8
CONFIDENCE_HIGH_PRS=8
CONFIDENCE_HIGH_COMMENTS=15
